<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置。

  Android 9（API 28）起默认禁止明文 HTTP。而登录回调必须走明文：
  Trae 的 `http://127.0.0.1:51120/authorize`、Antigravity 的 51121 ——
  上游注册的 redirect_uri 就是 http 回环地址，改不了 https。

  这里**只对回环地址**放行（127.0.0.1 / localhost / ::1），其它域名仍然强制 HTTPS：
  全开 `usesCleartextTraffic="true"` 会让所有上游请求都可能被中间人降级，没必要冒这个险。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
